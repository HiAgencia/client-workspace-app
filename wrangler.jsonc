	"routes": [{ "pattern": "brief.hiagencia.com", "custom_domain": true }],
	"placement": {
		"region": "aws:us-west-2"
	},
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://qtbfjdlcpqydhrkyvtac.supabase.co",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_arRwwtxUt08Gmt09zvSmiw_yx57vEOM",
