# Names of the local variables; values live only in .dev.vars (ignored).
# The Supabase ones are written by `pnpm dev-vars` with SUPABASE_ACCESS_TOKEN set.
NEXTJS_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Connecting Google accounts: the OAuth client, and a 32-byte base64 key that encrypts the stored tokens
# (changing it makes the stored tokens unreadable).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# The AI's one switch: `simulated` runs without spend; `meta` calls Meta Model API with MODEL_API_KEY; without a value it is
# off, and the chat, the voice and the images say they are not available without calling any model.
MODEL_PROVIDER=simulated
MODEL_API_KEY=
# Optional daily caps (defaults in src/lib/chat/usage.ts): per person, per demo session, and for all demo sessions.
CHAT_DAILY_CAP=
TRANSCRIPTION_DAILY_CAP=
DEMO_CHAT_DAILY_CAP=
DEMO_TRANSCRIPTION_DAILY_CAP=
DEMO_TOTAL_CHAT_DAILY_CAP=
DEMO_TOTAL_TRANSCRIPTION_DAILY_CAP=
# What the server's key may spend before each person goes on with their own key from Settings, in dollars (125 if unset).
AI_CREDIT_CAP_USD=

# The GA4 measurement ID for this deployment, public by design (empty: nothing measures).
GA_MEASUREMENT_ID=
